# MongoDB Connection URI (Atlas or Local)
# Replace placeholders with your own database credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Backend Server Port
PORT=3000

# Environment Mode ("development" or "production")
NODE_ENV=development

# Razorpay Test Gateway API Credentials (from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
