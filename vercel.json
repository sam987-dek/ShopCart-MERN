{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/customers/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/customers",
      "dest": "backend/index.js"
    },
    {
      "src": "/products/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/products",
      "dest": "backend/index.js"
    },
    {
      "src": "/wishlist/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/wishlist",
      "dest": "backend/index.js"
    },
    {
      "src": "/cart/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/cart",
      "dest": "backend/index.js"
    },
    {
      "src": "/orders/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/orders",
      "dest": "backend/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
